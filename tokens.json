{
  "metadata": {
    "name": "CodexMeter Design System — Signal & Silence",
    "version": "1.0.0",
    "format": "DTCG-inspired",
    "platform": "macOS 14+",
    "description": "Machine-readable foundations for CodexMeter's native, glanceable usage interface. Values are expressed in macOS points and seconds unless noted otherwise."
  },
  "core": {
    "space": {
      "$type": "dimension",
      "1": {
        "$value": { "value": 4, "unit": "pt" },
        "$description": "Tight icon and label separation."
      },
      "2": {
        "$value": { "value": 8, "unit": "pt" },
        "$description": "Compact component inset and related-item gap."
      },
      "3": {
        "$value": { "value": 12, "unit": "pt" },
        "$description": "Default component gap."
      },
      "4": {
        "$value": { "value": 16, "unit": "pt" },
        "$description": "Surface inset and section separation."
      },
      "6": {
        "$value": { "value": 24, "unit": "pt" },
        "$description": "Large editorial pause between content groups."
      }
    },
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": { "value": 10, "unit": "pt" },
        "$description": "Buttons, status pills, and compact controls."
      },
      "panel": {
        "$value": { "value": 14, "unit": "pt" },
        "$description": "Inset quota and status panels."
      },
      "surface": {
        "$value": { "value": 24, "unit": "pt" },
        "$description": "The floating widget's outer silhouette."
      }
    },
    "typography": {
      "family": {
        "interface": {
          "$type": "fontFamily",
          "$value": "system-rounded",
          "$description": "SF Pro Rounded through SwiftUI system APIs; never bundled."
        },
        "data": {
          "$type": "fontFamily",
          "$value": "system-monospaced",
          "$description": "SF Mono-compatible system face for exact values and timestamps."
        }
      },
      "size": {
        "$type": "dimension",
        "brand": { "$value": { "value": 10, "unit": "pt" } },
        "label": { "$value": { "value": 10, "unit": "pt" } },
        "metadata": { "$value": { "value": 10, "unit": "pt" } },
        "body": { "$value": { "value": 11, "unit": "pt" } },
        "quota": { "$value": { "value": 23, "unit": "pt" } },
        "hero": { "$value": { "value": 30, "unit": "pt" } }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 }
      }
    },
    "color": {
      "palette": {
        "signal": {
          "$type": "color",
          "$value": "#6BAB87",
          "$description": "CodexMeter's single identity signal; use sparingly."
        },
        "amber": {
          "$type": "color",
          "$value": "system.orange"
        },
        "red": {
          "$type": "color",
          "$value": "system.red"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": { "light": "system.labelColor", "dark": "system.labelColor" }
        },
        "secondary": {
          "$type": "color",
          "$value": { "light": "system.secondaryLabelColor", "dark": "system.secondaryLabelColor" }
        },
        "tertiary": {
          "$type": "color",
          "$value": { "light": "system.tertiaryLabelColor", "dark": "system.tertiaryLabelColor" }
        }
      },
      "surface": {
        "widget": {
          "$type": "color",
          "$value": { "light": "system.windowMaterial", "dark": "system.windowMaterial" },
          "$description": "Native material; provide an opaque fallback when transparency is reduced."
        },
        "inset": {
          "$type": "color",
          "$value": { "semantic": "system.primary", "opacity": 0.055 }
        },
        "selected": {
          "$type": "color",
          "$value": { "semantic": "system.primary", "opacity": 0.12 }
        },
        "track": {
          "$type": "color",
          "$value": { "semantic": "system.primary", "opacity": 0.09 }
        },
        "border": {
          "$type": "color",
          "$value": { "semantic": "system.primary", "opacity": 0.12 }
        },
        "divider": {
          "$type": "color",
          "$value": { "semantic": "system.primary", "opacity": 0.1 }
        }
      },
      "tone": {
        "neutral": {
          "$type": "color",
          "$value": { "light": "system.secondaryLabelColor", "dark": "system.secondaryLabelColor" }
        },
        "healthy": {
          "$type": "color",
          "$value": "{core.color.palette.signal}"
        },
        "caution": {
          "$type": "color",
          "$value": "{core.color.palette.amber}"
        },
        "critical": {
          "$type": "color",
          "$value": "{core.color.palette.red}"
        },
        "live": {
          "$type": "color",
          "$value": "{core.color.palette.signal}"
        },
        "cached": {
          "$type": "color",
          "$value": "{core.color.palette.amber}"
        },
        "offline": {
          "$type": "color",
          "$value": "{core.color.palette.red}"
        }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": { "value": 0.16, "unit": "s" } },
        "standard": { "$value": { "value": 0.24, "unit": "s" } },
        "layoutMorph": { "$value": { "value": 0.38, "unit": "s" } },
        "data": { "$value": { "value": 0.42, "unit": "s" } },
        "refresh": { "$value": { "value": 0.85, "unit": "s" } }
      },
      "curve": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.22, 1, 0.36, 1],
          "$description": "Shared state-transition curve."
        }
      }
    }
  },
  "component": {
    "widget": {
      "width": {
        "$type": "dimension",
        "$value": { "value": 348, "unit": "pt" }
      },
      "height": {
        "$type": "dimension",
        "$value": { "value": 238, "unit": "pt" }
      },
      "minimalWidth": {
        "$type": "dimension",
        "$value": { "value": 110, "unit": "pt" }
      },
      "minimalHeight": {
        "$type": "dimension",
        "$value": { "value": 110, "unit": "pt" }
      },
      "radius": { "$value": "{core.radius.surface}" },
      "contentInset": { "$value": "{core.space.4}" }
    },
    "brandGlyph": {
      "size": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "pt" }
      },
      "menuBarSize": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "pt" }
      }
    },
    "quotaRing": {
      "diameter": {
        "$type": "dimension",
        "$value": { "value": 84, "unit": "pt" }
      },
      "minimalDiameter": {
        "$type": "dimension",
        "$value": { "value": 84, "unit": "pt" }
      },
      "minimalGlassDiameter": {
        "$type": "dimension",
        "$value": { "value": 78, "unit": "pt" }
      }
    },
    "control": {
      "size": {
        "$type": "dimension",
        "$value": { "value": 28, "unit": "pt" }
      },
      "modeWidth": {
        "$type": "dimension",
        "$value": { "value": 68, "unit": "pt" }
      },
      "settingsWidth": {
        "$type": "dimension",
        "$value": { "value": 78, "unit": "pt" }
      },
      "radius": { "$value": "{core.radius.control}" }
    }
  },
  "policy": {
    "quotaSeverity": {
      "$type": "object",
      "$value": {
        "criticalMaximumRemainingPercent": 20,
        "cautionMaximumRemainingPercent": 50,
        "healthyMaximumRemainingPercent": 100
      }
    },
    "reducedMotion": {
      "$type": "object",
      "$value": {
        "transitionDurationSeconds": 0,
        "continuousMotionEnabled": false
      }
    }
  }
}
